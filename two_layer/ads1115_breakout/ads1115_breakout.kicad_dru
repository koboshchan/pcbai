(version 1)
(rule "Home etch copper clearance" (constraint clearance (min 0.5mm)))
(rule "Home etch copper edge" (constraint edge_clearance (min 0.5mm)))
(rule "Home etch minimum track" (constraint track_width (min 0.3mm)))
(rule "Home drill annular ring" (constraint annular_width (min 0.4mm)))
(rule "No vias" (constraint disallow via))
